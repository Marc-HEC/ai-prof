# Copier en demo/.env (jamais commite). Sans aucune cle, la demo tourne en
# mode "mock" : interface, avatar et lip-sync fonctionnent, les reponses sont
# factices.

# --- LLM -------------------------------------------------------------------
# Une cle gratuite suffit. Groq : https://console.groq.com/keys
# Gemini : https://aistudio.google.com/apikey (sait aussi lire les images)
GROQ_API_KEY=
GEMINI_API_KEY=

# groq | gemini | ollama | openai | mock. Vide : la premiere cle trouvee.
LLM_PROVIDER=
# Surcharge du modele. `python demo/start.py --check` liste ceux disponibles.
# LLM_MODEL=openai/gpt-oss-120b
# LLM_REASONING_EFFORT=low
# Ollama en local sur CPU (lent mais 100 % prive) :
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:3b

# Vision (dessins du tableau, photos de cours). Vide : Gemini si la cle existe.
# VISION_PROVIDER=gemini
# VISION_MODEL=gemini-flash-latest

# --- STT -------------------------------------------------------------------
# groq (Whisper par API, rapide) | local (faster-whisper sur CPU) | mock
STT_ENGINE=
# local : tiny | base | small | medium. "small" est le bon compromis sur CPU.
# STT_MODEL=small

# --- TTS -------------------------------------------------------------------
# piper (local, CPU) | edge (voix Microsoft en ligne, plus naturelles) | mock
TTS_ENGINE=piper
PIPER_VOICE=fr_FR-siwis-medium
# EDGE_VOICE=fr-FR-DeniseNeural

# --- Divers ----------------------------------------------------------------
# Persona : un fichier de backend/personas/, sans .md
PERSONA=prof
HOST=127.0.0.1
PORT=8000
