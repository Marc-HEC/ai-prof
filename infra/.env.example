# Copier en infra/.env et remplir. Ce fichier est ignore par git.
#
# Aucun secret de ce fichier ne doit se retrouver dans une image Docker :
# il est lu par docker compose a l'execution, jamais copie dans un layer.

# --- Persona active ---------------------------------------------------------
# Correspond a voices/<PERSONA>/ et a backend/personas/<PERSONA>.yaml
PERSONA=default

# --- Essai A ----------------------------------------------------------------
RUN_ID=latest
# Requis uniquement si un modele candidat est sous acces controle sur Hugging Face.
HF_TOKEN=

# --- Essai B et production --------------------------------------------------
# Paquet du moteur TTS retenu a l'issue de l'essai A.
TTS_PACKAGE=chatterbox-tts
LLM_MODEL=hermes3:8b
WHISPER_MODEL=large-v3

# --- Acces distant ----------------------------------------------------------
# Cle d'authentification Tailscale, de preference EPHEMERE et taguee, pour que le
# noeud disparaisse tout seul du tailnet a la destruction du pod.
TS_AUTHKEY=
TS_TAGS=tag:aigf
POD_NAME=aigf-pod
